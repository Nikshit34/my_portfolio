body {
    background-color: #eaf2f8;
    font-family: Arial, sans-serif;
}

.container {
    background-color: white;
    width: 350px;
    margin: auto;
    margin-top: 60px;
    padding: 25px;
    text-align: center;
    border-radius: 15px;
    box-shadow: 0px 0px 10px gray;
}

.profile-pic {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #3498db;
}

h1 {
    color: #2c3e50;
}

h2 {
    color: #3498db;
}

p, li {
    font-size: 14px;
}

